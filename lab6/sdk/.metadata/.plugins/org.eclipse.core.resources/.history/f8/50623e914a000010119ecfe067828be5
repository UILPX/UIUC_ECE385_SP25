volatile uint32_t* b_sw = (uint32_t *)XPAR_GPIO_0_BASEADDR; 			 //Hint: either find the manual address (via the memory map in the block diagram, or
volatile uint32_t* led = (uint32_t *)XPAR_GPIO_0_BASEADDR+0x00000008;		 //replace with the proper define in xparameters (part of the BSP). Either way
