int main()
{
    init_platform();

int curr = 0;
int prev = 0;

    while (1) {
            // Check button pressed
    	curr = *b_sw & 0x00010000;
    	sleep(1);
            if (curr && !prev) {
                	xil_printf("Button pressed!\r\n");
                	xil_printf("b_sw = %u led = %u\r\n",*b_sw & 0x0000FFFF,*led);
                // Accumulate values
                (*led & 0x0000FFFF) += (*b_sw & 0x0000FFFF);
                	xil_printf("New value = %u\r\n",*led);

                //overflow detection
                if (sum > 65535) {
                    	xil_printf("Overflow detected! Resetting accumulator.\n");
                    (*led & 0x0000FFFF) = 0;  // Keep lower 16 bits, clear overflow
                    	xil_printf("led = %u\r\n",*led);
                }
            }
            prev = curr;
        }

    cleanup_platform();

    return 0;
}
