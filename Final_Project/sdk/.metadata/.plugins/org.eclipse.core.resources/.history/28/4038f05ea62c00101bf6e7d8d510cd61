#include "gpu_axi_lite.h"
#include "xil_io.h"
#include <unistd.h>

void gpu_init(void) { /* nothing yet */ }

void gpu_wait_ready(void)
{
    while ( (Xil_In32(GPU_DATA_LO) & (GPU_CTL_DONE_MASK << GPU_CTL_NIBBLE_SHIFT)) == 0 )
    	//xil_printf("Waiting\r\n")
        ;                           /* wait for DONE=1 */
}

void gpu_send_scanline(uint32_t lo, uint32_t hi_data)
{
    gpu_wait_ready();                                   /* GPU idle      */
    Xil_Out32(GPU_DATA_HI, hi_data);                         /* data bits 31:0*/
    //xil_printf("%x",hi_data);
    uint32_t LO = (lo & 0x0FFFFFFF)                /* keep 28 LSB   */
                | (GPU_CTL_RUN << GPU_CTL_NIBBLE_SHIFT);
    Xil_Out32(GPU_DATA_LO, LO);                         /* data+RUN      */
    //xil_printf("%x\r\n",LO);
    usleep(50000);
}

void gpu_frame_done(void)
{
    gpu_wait_ready();
    Xil_Out32(GPU_DATA_HI, 0);                           /* payload unused*/
    Xil_Out32(GPU_DATA_LO, GPU_CTL_FRAME_DONE << GPU_CTL_NIBBLE_SHIFT);
    //xil_printf("----\r\n");
}
