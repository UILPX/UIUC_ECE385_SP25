
/* gpu_axi_lite.h  ¨C handshake helpers with READY/HOLD logic
 *
 * Register map (64 bit data word accessed via two 32 bit accesses):
 *   0x00   REG1   packed y/u/v  (write©\only)
 *   0x04   REG2   packed x/z    (write©\only)
 *   0x08   CTRL   [63] DONE (GPU ¡ú CPU, 1 = GPU idle/ready)
 *                 [61] FRAME_DONE (CPU ¡ú GPU, pulse)
 *                 [60] RUN (CPU ¡ú GPU, pulse for new line)
 *
 *  MicroBlaze writes low 32 bits; the BSP splits 64 bit flags into
 *  two 32 bit accesses under the hood, so CTRL is treated as 32 bit
 *  but we only care about the lower 4 bits and DONE in bit 31 alias.
 */

#ifndef GPU_AXI_LITE_H
#define GPU_AXI_LITE_H
#include "xil_io.h"
#include "xparameters.h"

/* base address configured in Vivado */
#define GPU_BASE       XPAR_HDMI_TEXT_CONTROLLER_0_AXI_BASEADDR
#define GPU_REG1       (GPU_BASE + 0x00)
#define GPU_REG2       (GPU_BASE + 0x04)
#define GPU_CTRL       (GPU_BASE + 0x08)

/* bit positions within CTRL low word */
#define GPU_CTRL_RUN          0x1      /* bit0 -> data[60] */
#define GPU_CTRL_FRAME_DONE   0x2      /* bit1 -> data[61] */
#define GPU_CTRL_DONE_MASK    0x80000000u /* alias of data[63] */

static inline void gpu_wait_ready(void)
{
    while ((Xil_In32(GPU_CTRL) & GPU_CTRL_DONE_MASK) == 0u) ;
}

static inline void gpu_send_scanline(uint32_t r1, uint32_t r2)
{
    gpu_wait_ready();
    Xil_Out32(GPU_REG1, r1);
    Xil_Out32(GPU_REG2, r2);
    Xil_Out32(GPU_CTRL, GPU_CTRL_RUN);
}

static inline void gpu_frame_done(void)
{
    gpu_wait_ready();
    Xil_Out32(GPU_CTRL, GPU_CTRL_FRAME_DONE);
}
#endif
