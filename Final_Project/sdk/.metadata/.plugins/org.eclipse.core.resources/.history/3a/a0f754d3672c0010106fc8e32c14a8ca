/* —— stats.c ——————————————————————————————— */
#include "stats.h"
#include "xil_printf.h"

static volatile uint32_t sl_this_frame = 0;
static volatile uint32_t bytes_this_frame = 0;

static uint32_t frame_accum = 0;
static uint64_t sl_accum   = 0;
static uint64_t bytes_accum = 0;

static XTime t_last = 0;

void stats_scanline_sent(void)
{
    sl_this_frame++;
    bytes_this_frame += 8;   /* 2×32-bit = 8 字节，如有第三个 ctrl word 改成 12 */
}

void stats_frame_done(void)
{
    frame_accum++;
    sl_accum    += sl_this_frame;
    bytes_accum += bytes_this_frame;

    sl_this_frame    = 0;
    bytes_this_frame = 0;

    XTime t_now;
    XTime_GetTime(&t_now);

    if (t_last == 0)         /* 第一次调用 */
        t_last = t_now;

    if ((t_now - t_last) >= COUNTS_PER_SECOND) {   /* 一秒到了 */
        float fps = (float)frame_accum;
        uint32_t avg_sl  = (uint32_t)(sl_accum   / fps);
        uint32_t avg_bpf = (uint32_t)(bytes_accum/ fps);

        xil_printf("FPS: %.1f | avg scanlines: %u | avg bytes/frame: %u\r\n",
                   fps, avg_sl, avg_bpf);

        /* 归零重新计时 */
        frame_accum = 0;
        sl_accum    = 0;
        bytes_accum = 0;
        t_last      = t_now;
    }
}